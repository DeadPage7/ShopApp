<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Pages.AddressesPage"
             BackgroundColor="#334D34">
    <!-- Основной фон, как на главной странице -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ScrollView для прокрутки контента -->
        <ScrollView>
            <VerticalStackLayout Padding="10">

                <!-- Заголовок страницы -->
                <Label Text="Ваши адреса:" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#EAE4C2" />
                <!-- Светлый цвет текста -->

                <!-- Коллекция адресов -->
                <CollectionView x:Name="AddressesCollectionView"
                                SelectionChanged="OnAddressTapped"
                                SelectionMode="Single" Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                <!-- Контейнер для адреса с тенью и округлыми углами -->
                                <Frame Grid.Column="0" Padding="15" Margin="5" BorderColor="#719442" CornerRadius="15" BackgroundColor="#719442">
                                    <!-- Светлый фон для контейнера -->
                                    <VerticalStackLayout Spacing="10">
                                        <Label Text="{Binding City}" FontSize="20" FontAttributes="Bold" TextColor="#EAE4C2"/>
                                        <!-- Тёмный цвет текста -->
                                        <Label Text="{Binding Street}" FontSize="16" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding House, StringFormat='Дом: {0}'}" FontSize="14" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding Floor, StringFormat='Этаж: {0}'}" FontSize="14" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding ApartmentOrOffice, StringFormat='Квартира/офис: {0}'}" FontSize="14" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding Entrance, StringFormat='Подъезд: {0}'}" FontSize="14" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding Intercom, StringFormat='Домофон: {0}'}" FontSize="14" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding Comment, StringFormat='Комментарий: {0}'}" FontSize="14" TextColor="#EAE4C2"/>
                                    </VerticalStackLayout>
                                </Frame>

                                <!-- Кнопка удаления с ярким значком -->
                                <Button Grid.Column="1" Grid.Row="0" Text="❌"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        FontSize="24"
                                        Padding="10"
                                        Clicked="OnDeleteAddressClicked"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Кнопка для создания нового адреса -->
        <Button Grid.Row="1"
                Text="Создать адрес"
                FontAttributes="Bold"
                BackgroundColor="#719442"
            TextColor="White"
                CornerRadius="30"
                Padding="15"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="End"
                Margin="20"
                FontSize="18"
                Clicked="OnCreateAddressClicked" />
    </Grid>

</ContentPage>