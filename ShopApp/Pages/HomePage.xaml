<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShopApp.Pages.HomePage"
             BackgroundColor="#334D34">

    <!-- Основной контейнер -->
    <Grid>

        <!-- Основной контент страницы -->
        <StackLayout Spacing="20" VerticalOptions="FillAndExpand">
            <!-- Верхняя панель -->
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="20">
                <!-- Логотип -->
                <Image Source="logo.png" HeightRequest="40" WidthRequest="40" Grid.Column="0" VerticalOptions="Center" />

                <!-- Имя пользователя -->
                <Label x:Name="LabelClientName" 
                       FontSize="18" 
                       TextColor="#EAE4C2" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       Grid.Column="1" />

                <!-- Иконка корзины -->
                <ImageButton Source="cart_icon.png" 
                             HeightRequest="20" 
                             WidthRequest="30" 
                             Grid.Column="2" 
                             VerticalOptions="Center"
                             BackgroundColor="Transparent" Clicked="OnCartButtonClicked"/>
            </Grid>

            <BoxView HeightRequest="5" Margin="0,-30,0,0" BackgroundColor="#719442" />

            <!-- Список категорий -->
            <CollectionView x:Name="CategoryCollectionView" 
                ItemsSource="{Binding Categories}" 
                SelectionMode="Single" 
                HorizontalScrollBarVisibility="Never"
                HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="5">
                            <Frame Padding="5" CornerRadius="5" Margin="3" BackgroundColor="#719442">
                                <Label Text="{Binding Name}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="#EAE4C2" 
                           HorizontalTextAlignment="Center" />
                            </Frame>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <BoxView HeightRequest="5" BackgroundColor="#719442"/>

            <!-- Карусель продуктов -->
            <CarouselView x:Name="ProductCarouselView" 
                          ItemsSource="{Binding Products}" 
                          Loop="True" 
                          HorizontalOptions="Center" 
                          IndicatorView="IndicatorView">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#719442" CornerRadius="20" WidthRequest="350" HeightRequest="650" HasShadow="True">
                            <Frame BackgroundColor="#334D34" CornerRadius="10" WidthRequest="300" HeightRequest="600" HasShadow="True">
                                <StackLayout Spacing="5">
                                    <Image Source="{Binding Photo}" HeightRequest="300" Margin="0, 116, 0, 0" WidthRequest="250"/>
                                    <Label Text="{Binding Name}" HorizontalOptions="Center" FontSize="30" FontAttributes="Bold" TextColor="#EAE4C2"/>
                                    <Label Text="{Binding Price, StringFormat='Цена: {0:C}'}" FontSize="25" TextColor="#EAE4C2" HorizontalOptions="Center"/>
                                    <Button Text="Подробнее" CornerRadius="10" BorderWidth="3" BorderColor="#25463D"  WidthRequest="200" FontAttributes="Bold" Background="#719442" FontSize="20" Clicked="OnDetailsProductButtonClicked"></Button>
                                </StackLayout>
                            </Frame>
                        </Frame>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Индикаторы -->
            <IndicatorView x:Name="IndicatorView" 
                           IndicatorColor="#EAE4C2" 
                           SelectedIndicatorColor="#719442"
                           HorizontalOptions="Center" 
                           VerticalOptions="End" 
                           IndicatorSize="10" />
        </StackLayout>

        <!-- Панель навигации внизу -->
        <StackLayout BackgroundColor="#719442" VerticalOptions="EndAndExpand">
            <!-- Панель навигации по ширине -->
            <Grid HorizontalOptions="FillAndExpand">
                <!-- Определяем 3 равные колонки -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Кнопка Каталог -->
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0">
                    <ImageButton Source="product.png" 
                         HeightRequest="40" 
                         WidthRequest="40" 
                         BackgroundColor="Transparent"
                         Clicked="OnCatalogButtonClicked" />
                    <Label Text="Каталог" 
                   FontSize="12" 
                   TextColor="#EAE4C2" 
                   HorizontalOptions="Center" />
                </StackLayout>

                <!-- Кнопка Профиль -->
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="1">
                    <ImageButton Source="profile.png" 
                         HeightRequest="40" 
                         WidthRequest="40" 
                         BackgroundColor="Transparent"
                         Clicked="OnProfileButtonClicked" />
                    <Label Text="Профиль" 
                   FontSize="12" 
                   TextColor="#EAE4C2" 
                   HorizontalOptions="Center" />
                </StackLayout>

                <!-- Кнопка Главная -->
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="2">
                    <ImageButton Source="home.png" 
                         HeightRequest="40" 
                         WidthRequest="40" 
                         BackgroundColor="Transparent"
                          />
                    <Label Text="Главная" 
                   FontSize="12" 
                   TextColor="#EAE4C2" 
                   HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </StackLayout>
    </Grid>

</ContentPage>
