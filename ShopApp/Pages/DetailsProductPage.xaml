<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShopApp.Pages.DetailsProductPage"
             BackgroundColor="#334D34">

    <!-- Основная сетка для разделения экрана -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Верхняя панель с логотипом, именем и корзиной -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="10">
            <!-- Логотип -->
            <Image Source="logo.png" HeightRequest="40" WidthRequest="40" Grid.Column="0" VerticalOptions="Center" />

            <!-- Имя пользователя -->
            <Label x:Name="LabelClientName"
                   FontSize="18"
                   TextColor="#EAE4C2"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Grid.Column="1" />
            <!-- Этот Label будет отображать имя пользователя -->

            <!-- Иконка корзины -->
            <ImageButton Source="cart_icon.png"
                         HeightRequest="30"
                         WidthRequest="30"
                         Grid.Column="2"
                         VerticalOptions="Center"
                         BackgroundColor="Transparent"
                         Clicked="OnCartButtonClicked"/>
        </Grid>

        <!-- Верхняя часть: Название и Фото -->
        <StackLayout Grid.Row="1" Spacing="10" VerticalOptions="Start">
            <BoxView HeightRequest="5" BackgroundColor="#719442"/>

            <Label x:Name="ProductName"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#EAE4C2" />
            <BoxView HeightRequest="5" BackgroundColor="#719442"/>

            <Image x:Name="ProductImage"
                   HeightRequest="250"
                   WidthRequest="250"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </StackLayout>

        <!-- Нижняя часть: Описание, цена, кнопка и счетчик -->
        <!-- Изменения: Верхняя часть с закругленными углами, нижняя часть с прямыми -->
        <Frame Grid.Row="2"
               BackgroundColor="#719442"
               Padding="5"
               VerticalOptions="End">
            <StackLayout Spacing="15">
                <!-- Заголовок "Подробнее" -->
                <Label Text="Подробнее"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#EAE4C2"
                       HorizontalOptions="Center" />

                <!-- Подробное описание -->
                <Label x:Name="ProductDescription"
                       FontSize="16"
                       TextColor="#EAE4C2"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center" />

                <!-- Цена над кнопкой -->
                <Label x:Name="ProductPrice"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#EAE4C2"
                       HorizontalOptions="End"
                       Margin="0,10,45,0"/>

                <!-- Кнопка и счетчик -->
                <Grid ColumnDefinitions="2*, 3*" Padding="10" ColumnSpacing="10">
                    <!-- Счетчик: + и - -->
                    <StackLayout Orientation="Horizontal" Grid.Column="0" HorizontalOptions="Start" Spacing="10">
                        <Button Text="-"
                                FontSize="60"
                                BackgroundColor="#EAE4C2"
                                TextColor="#25463D"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                WidthRequest="40"
                                HeightRequest="40"
                                Clicked="OnDecreaseButtonClicked" />
                        <Label x:Name="QuantityLabel"
                               Text="1"
                               FontSize="20"
                               TextColor="#EAE4C2"
                               VerticalTextAlignment="Center" />
                        <Button Text="+"
                                FontSize="30"
                                BackgroundColor="#EAE4C2"
                                TextColor="#25463D"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                WidthRequest="40"
                                HeightRequest="40"
                                Clicked="OnIncreaseButtonClicked" />
                        <!-- Обработчик для увеличения -->
                    </StackLayout>

                    <!-- Кнопка "Добавить в корзину" -->
                    <Button Text="Добавить в корзину"
                            Grid.Column="1"
                            FontSize="20"
                            BackgroundColor="#334D34"
                            TextColor="#EAE4C2"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="70"
                            HorizontalOptions="End"
                            Clicked="OnBuyButtonClicked"
                            BorderWidth="3" BorderColor="#EAE4C2"/>
                </Grid>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>
