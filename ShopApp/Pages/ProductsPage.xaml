<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShopApp.Pages.ProductsPage"
             BackgroundColor="#334D34">

    <Grid RowDefinitions="*, Auto">
        <!-- Основное содержимое страницы -->
        <ScrollView Grid.Row="0">
            <Grid RowDefinitions="Auto, 5, Auto, 5, *" Padding="10">
                <!-- Верхняя панель -->
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="10" Grid.Row="0">
                    <!-- Логотип -->
                    <Image Source="logo.png" HeightRequest="40" WidthRequest="40" Grid.Column="0" VerticalOptions="Center" />

                    <!-- Имя пользователя -->
                    <Label x:Name="LabelClientName" 
                           FontSize="18" 
                           TextColor="#EAE4C2" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Grid.Column="1" />

                    <!-- Иконка корзины -->
                    <ImageButton Source="cart_icon.png" 
                                 HeightRequest="30" 
                                 WidthRequest="30" 
                                 Grid.Column="2" 
                                 VerticalOptions="Center"
                                 BackgroundColor="Transparent" 
                                 Clicked="OnCartButtonClicked"/>
                </Grid>

                <!-- Линия под верхней панелью -->
                <BoxView HeightRequest="5" BackgroundColor="#719442" Grid.Row="1" Margin="-10,2" />

                <!-- Список категорий -->
                <CollectionView x:Name="CategoryCollectionView" 
                                ItemsSource="{Binding Categories}" 
                                SelectionMode="Single" 
                                HorizontalScrollBarVisibility="Never"
                                HorizontalOptions="Center"
                                Grid.Row="2"
                                Margin="20">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="5">
                                <Frame Padding="5" BackgroundColor="#719442" CornerRadius="5">
                                    <Label Text="{Binding Name}" 
                                       FontSize="14" 
                                       TextColor="#EAE4C2" 
                                       HorizontalTextAlignment="Center" 
                                       Margin="0,0"/>
                                </Frame>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Линия под категориями -->
                <BoxView HeightRequest="5" BackgroundColor="#719442" Grid.Row="3" Margin="-10,2" />

                <!-- Список продуктов -->
                <CollectionView x:Name="ProductsCollectionView" 
                                ItemsSource="{Binding Products}" 
                                SelectionMode="Single" 
                                HorizontalScrollBarVisibility="Never"
                                Grid.Row="4">
                    <CollectionView.ItemsLayout>
                        <!-- Используем GridItemsLayout для отображения товаров в 2 колонки с маленькими отступами -->
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" BackgroundColor="#719442" CornerRadius="10" HasShadow="True">
                                <Frame BackgroundColor="#334D34" CornerRadius="10" Padding="10" HasShadow="True">
                                    <StackLayout Spacing="5" HorizontalOptions="CenterAndExpand">
                                        <Image Source="{Binding Photo}" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center" />
                                        <Label Text="{Binding Name}" TextColor="#EAE4C2" HorizontalOptions="Center" FontSize="20"/>
                                        <Label Text="{Binding Price, StringFormat='Цена: {0:C}'}" FontSize="18" TextColor="#EAE4C2" HorizontalOptions="Center" />
                                        <Button Text="Подробнее" CornerRadius="10" BorderWidth="3" BorderColor="#25463D" WidthRequest="200" FontAttributes="Bold" Background="#719442" FontSize="20" Clicked="OnDetailsProductButtonClicked"></Button>
                                    </StackLayout>
                                </Frame>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ScrollView>

        <!-- Панель навигации снизу -->
        <StackLayout Grid.Row="1" BackgroundColor="#719442" VerticalOptions="End">
            <!-- Панель навигации по ширине -->
            <Grid HorizontalOptions="FillAndExpand">
                <!-- Определяем 3 равные колонки -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Кнопка Каталог -->
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0">
                    <ImageButton Source="product.png" 
                                 HeightRequest="40" 
                                 WidthRequest="40" 
                                 BackgroundColor="Transparent"
                                 Clicked="OnCatalogButtonClicked" />
                    <Label Text="Каталог" 
                           FontSize="12" 
                           TextColor="#EAE4C2" 
                           HorizontalOptions="Center" />
                </StackLayout>

                <!-- Кнопка Профиль -->
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="1">
                    <ImageButton Source="profile.png" 
                                 HeightRequest="40" 
                                 WidthRequest="40" 
                                 BackgroundColor="Transparent"
                                 Clicked="OnProfileButtonClicked" />
                    <Label Text="Профиль" 
                           FontSize="12" 
                           TextColor="#EAE4C2" 
                           HorizontalOptions="Center" />
                </StackLayout>

                <!-- Кнопка Главная -->
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="2">
                    <ImageButton Source="home.png" 
                                 HeightRequest="40" 
                                 WidthRequest="40" 
                                 BackgroundColor="Transparent"
                                 Clicked="OnHomeButtonClicked" />
                    <Label Text="Главная" 
                           FontSize="12" 
                           TextColor="#EAE4C2" 
                           HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </StackLayout>
    </Grid>
</ContentPage>
