<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Pages.DetailsOrderPage"
             BackgroundColor="#334D34">

    <!-- Обернули весь контент в ScrollView -->
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="15">

            <!-- Заголовок -->
            <Label Text="Детали заказа"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#EAE4C2" />

            <!-- Информация о заказе -->
            <Label Text="Номер заказа:" FontAttributes="Bold" TextColor="#EAE4C2"/>
            <Label x:Name="OrderIdLabel" FontSize="16" TextColor="#EAE4C2"/>

            <Label Text="Дата заказа:" FontAttributes="Bold" TextColor="#EAE4C2"/>
            <Label x:Name="OrderDateLabel" FontSize="16" TextColor="#EAE4C2"/>

            <Label Text="Общая сумма:" FontAttributes="Bold" TextColor="#EAE4C2"/>
            <Label x:Name="TotalCostLabel" FontSize="16" TextColor="#EAE4C2"/>

            <!-- Заголовок списка товаров -->
            <Label Text="Товары в заказе" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,5" 
                   TextColor="#EAE4C2"/>

            <!-- Список товаров -->
            <CollectionView x:Name="ItemsListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#719442" Padding="10" Margin="0,10" BackgroundColor="#334D34">
                            <HorizontalStackLayout Spacing="15">
                                <!-- Изображение товара с фоном и бордером -->
                                <Frame BackgroundColor="#334D34" BorderColor="#719442" Padding="5" CornerRadius="10">
                                    <Image Source="{Binding Product.Photo}" 
                                           HeightRequest="100" 
                                           WidthRequest="100"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center"/>
                                </Frame>

                                <VerticalStackLayout>
                                    <!-- Название товара -->
                                    <Label Text="{Binding Product.Name}" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#EAE4C2"/>

                                    <!-- Цена товара -->
                                    <Label Text="{Binding Product.Price, StringFormat='💰 Цена: {0:C}'}" 
                                           FontSize="16" 
                                           TextColor="#EAE4C2"/>

                                    <!-- Количество товара -->
                                    <Label Text="{Binding Quantity, StringFormat='📦 Количество: {0}'}" 
                                           FontSize="16" 
                                           TextColor="#EAE4C2"/>

                                    <!-- Сумма товара -->
                                    <Label Text="{Binding TotalCost, StringFormat='Сумма: {0:C}'}" 
                                           FontSize="14" 
                                           TextColor="#EAE4C2"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
