<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Pages.CreateOrderPage"
             BackgroundColor="#334D34">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Заголовок, который сообщает, что нужно выбрать адрес доставки -->
                <Label Text="Выберите адрес доставки:"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" 
                       Margin="0,10,0,20"
                       TextColor="#EAE4C2"/>
                <!-- Белый текст с тёмно-зелёным фоном -->

                <!-- Список адресов, которые можно выбрать -->
                <CollectionView x:Name="AddressesCollectionView"
                                SelectionMode="Single"
                                SelectionChanged="OnAddressSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Spacing="10">
                                <!-- Карточка с информацией об адресе -->
                                <Frame Padding="15" Margin="0,0,0,10" BorderColor="#719442" BackgroundColor="#334D34" CornerRadius="10">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding City}" FontSize="18" FontAttributes="Bold" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding Street}" FontSize="16" TextColor="#EAE4C2"/>
                                        <Label Text="{Binding House}" FontSize="16" TextColor="#EAE4C2"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Блок для отображения выбранного адреса -->
                <Frame Padding="10" Margin="0,10,0,10" BorderColor="#719442" BackgroundColor="#334D34" CornerRadius="10">
                    <Label x:Name="SelectedAddressLabel"
                           Text="Адрес не выбран"
                           FontSize="18"
                           TextColor="#EAE4C2"
                           HorizontalOptions="Center"/>
                </Frame>

                <!-- Кнопка для оформления заказа -->
                <Button Text="Оформить заказ"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="#719442"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="15"
                        HorizontalOptions="FillAndExpand"
                    Clicked="OnPaymentButton"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
