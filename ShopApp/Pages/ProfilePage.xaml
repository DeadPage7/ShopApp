<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Pages.ProfilePage"
             Title="ProfilePage">
    <StackLayout Padding="20" Spacing="10">
        <Entry x:Name="fullname" Placeholder="Full Name" />
        <Entry x:Name="email" Placeholder="Email" />
        <Entry x:Name="login" Placeholder="Login" />
        <Entry x:Name="birth" Placeholder="Birth (YYYY-MM-DD)" />
        <Entry x:Name="phone" Placeholder="Phone" />
        <Button Text="Просмотреть адреса" Clicked="OnAddressButton" />
        <Button Text="Сохранить изменения" Clicked="OnSaveButton" />
        <Button Text="Просмотреть заказы" Clicked="OnOrdersButton" />
    </StackLayout>
</ContentPage>
