<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Pages.EditAddressPage"
             Title="Редактирование адреса"
             BackgroundColor="#334D34">

    <!-- Добавление ScrollView для прокрутки страницы, если контента слишком много -->
    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <!-- Заголовок страницы -->
            <Label Text="Редактирование адреса"
                   FontSize="30" 
                   FontAttributes="Bold" 
                   TextColor="#EAE4C2"
                   HorizontalOptions="Center" />

            <!-- Формы для ввода данных адреса -->
            <Frame BackgroundColor="#719442"
                   Padding="10"
                   CornerRadius="20"
                   HasShadow="True">
                <StackLayout Spacing="15">
                    <!-- Поля ввода для адреса -->

                    <!-- Город -->
                    <Label Text="Город:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="CityEntry" FontSize="18" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Улица -->
                    <Label Text="Улица:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="StreetEntry" FontSize="18" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Дом -->
                    <Label Text="Дом:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="HouseEntry" FontSize="18" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Этаж, с числовой клавиатурой -->
                    <Label Text="Этаж:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="FloorEntry" FontSize="18" Keyboard="Numeric" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Квартира/офис -->
                    <Label Text="Квартира/офис:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="ApartmentOrOfficeEntry" FontSize="18" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Подъезд -->
                    <Label Text="Подъезд:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="EntranceEntry" FontSize="18" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Домофон -->
                    <Label Text="Домофон:" FontSize="18" TextColor="#EAE4C2"/>
                    <Entry x:Name="IntercomEntry" FontSize="18" TextColor="#EAE4C2" BackgroundColor="#334D34" />

                    <!-- Комментарий -->
                    <Label Text="Комментарий:" FontSize="18" TextColor="#EAE4C2"/>
                    <Editor x:Name="CommentEditor" FontSize="18" HeightRequest="100" TextColor="#EAE4C2" BackgroundColor="#334D34" />
                </StackLayout>
            </Frame>

            <!-- Кнопка сохранения изменений -->
            <Button Text="Сохранить изменения" 
                    BackgroundColor="#719442" 
                    TextColor="#EAE4C2"
                    CornerRadius="10"
                    Clicked="OnSaveButtonClicked" />
        </StackLayout>
    </ScrollView>
</ContentPage>
