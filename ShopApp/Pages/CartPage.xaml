<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Pages.CartPage"
             BackgroundColor="#334D34">

    <!-- Обернули весь контент в ScrollView для удобства прокрутки -->
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="15">
            <!-- Верхняя линия -->
            <BoxView HeightRequest="2" Color="#719442" Opacity="0.5"/>

            <!-- Заголовок страницы с эмодзи корзины -->
            <Label 
                Text="🛒 Ваша корзина"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" 
                TextColor="#EAE4C2"/>

            <!-- Нижняя линия -->
            <BoxView HeightRequest="2" Color="#719442" Opacity="0.5"/>

            <!-- Список товаров в корзине -->
            <CollectionView x:Name="CartItemsView"
                            ItemsSource="{Binding Cartes}">
                <!-- Шаблон для отображения каждого элемента в корзине -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#719442"
                               CornerRadius="10" 
                               HasShadow="True" 
                               BackgroundColor="#334D34"
                               Padding="15"
                               Margin="0,0,0,0">
                            <!-- Горизонтальный StackLayout для отображения изображения товара и информации о нем -->
                            <HorizontalStackLayout Spacing="15">
                                <!-- Изображение товара с фоном -->
                                <Frame BackgroundColor="#334D34" CornerRadius="10" Padding="5" BorderColor="#719442">
                                    <Image Source="{Binding Photo}"
                                           HeightRequest="100" 
                                           WidthRequest="100"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center"/>
                                </Frame>

                                <!-- Информация о товаре -->
                                <VerticalStackLayout Spacing="10">
                                    <!-- Название товара -->
                                    <Label Text="{Binding Name}" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#EAE4C2"/>

                                    <!-- Цена товара -->
                                    <Label Text="{Binding Price, StringFormat='💰 Цена: {0:C}'}" 
                                           FontSize="16" 
                                           TextColor="#719442"/>

                                    <!-- Количество товара -->
                                    <Label Text="{Binding Quantity, StringFormat='📦 Количество: {0}'}" 
                                           FontSize="16" 
                                           TextColor="#EAE4C2"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Общая стоимость корзины -->
            <Label x:Name="TotalCostLabel"
                   Text="Общая стоимость: 0 ₽"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="End"
                   TextColor="#EAE4C2"/>

            <!-- Кнопка для оформления заказа, которая изначально скрыта -->
            <Button Text="✅ Оформить заказ"
                    x:Name="OrderButton"
                    IsVisible="False"  
                    BackgroundColor="#719442"
                    TextColor="#EAE4C2"
                    FontSize="18"
                    CornerRadius="10"
                    Padding="10"
                    Clicked="OnOrderButtonClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
